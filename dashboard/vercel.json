{
  "buildCommand": "pnpm install && pnpm build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/hourly-aggregation",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily-aggregation",
      "schedule": "0 0 * * *"
    }
  ]
}

